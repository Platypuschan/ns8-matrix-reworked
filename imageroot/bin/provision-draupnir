# Create the Draupnir account and management room once Synapse answers, and
# write the Draupnir configuration.

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "pypkg"))
import matrix_runtime
import matrix_setup

settings = matrix_setup.read_settings()
if not settings.get("draupnir"):
    sys.exit(0)
port_map = matrix_setup.ports()
matrix_runtime.wait_for_synapse(port_map["synapse"])
state = matrix_runtime.provision_draupnir(settings, port_map)
print("Draupnir management room:", state["management_room"], file=sys.stderr)
