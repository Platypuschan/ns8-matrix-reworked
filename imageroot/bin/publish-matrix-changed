# Publish the matrix-changed event for bridge modules.

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "pypkg"))
import matrix_runtime
import matrix_setup

settings = matrix_setup.read_settings()
if settings.get("host"):
    matrix_runtime.publish_changed(settings)
