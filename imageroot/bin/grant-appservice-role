# Role for bridge modules: their image asks for it with
# org.nethserver.authorizations=matrix-reworked@any:appserviceadm
set -e
exec 1>&2
redis-exec SADD "${AGENT_ID}/roles/appserviceadm" add-appservice remove-appservice get-matrix-info
