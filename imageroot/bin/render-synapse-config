# Run before each Synapse start: the LDAP proxy port, its bind password
# and the smarthost settings can change without a configure-module run.

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "pypkg"))
import matrix_runtime
import matrix_setup

with matrix_setup.settings_lock():
    settings = matrix_setup.read_settings()
    if not settings.get("host"):
        print("The module is not configured yet", file=sys.stderr)
        sys.exit(1)
    matrix_runtime.render_synapse(
        settings,
        matrix_setup.ports(),
        ldap=matrix_runtime.ldap_settings(settings.get("user_domain")),
        smarthost=matrix_runtime.smarthost_settings(),
        udp_map=matrix_setup.udp_ports(),
    )
    # This start uses the new files
    try:
        os.remove(matrix_setup.RESTART_FLAG.format("synapse"))
    except FileNotFoundError:
        pass
