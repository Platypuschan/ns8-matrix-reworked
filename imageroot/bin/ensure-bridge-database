#!/bin/bash

#
# SPDX-License-Identifier: GPL-3.0-or-later
#

# Create the PostgreSQL database of a bridge if it does not exist yet.
# Usage: ensure-bridge-database <database name>

set -euo pipefail

database="${1:?missing database name}"
if [[ ! "${database}" =~ ^mautrix_[a-z0-9]+$ ]]; then
    echo "Invalid bridge database name: ${database}" >&2
    exit 64
fi
exists="$(podman exec postgresql psql -U postgres -tAc "SELECT 1 FROM pg_database WHERE datname = '${database}'")"
if [[ "${exists}" != 1 ]]; then
    podman exec postgresql createdb -U postgres "${database}"
    echo "Created database ${database}" >&2
fi
