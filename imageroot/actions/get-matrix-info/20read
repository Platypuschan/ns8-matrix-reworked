# How bridge modules reach this homeserver.

import json
import os
import sys

import agent

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import matrix_setup

settings = matrix_setup.read_settings()
if not settings.get("host"):
    agent.set_status("validation-failed")
    json.dump([{"field": "module", "parameter": "module", "value": "", "error": "homeserver_not_configured"}],
              fp=sys.stdout)
    sys.exit(2)
json.dump(matrix_setup.matrix_info(settings, matrix_setup.ports()), fp=sys.stdout)
