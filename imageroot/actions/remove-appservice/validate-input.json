{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Remove an appservice",
    "$id": "http://nethserver.org/json-schema/task/input/matrix-reworked/remove-appservice",
    "examples": [
        {
            "id": "whatsapp"
        }
    ],
    "type": "object",
    "required": [
        "id"
    ],
    "properties": {
        "id": {
