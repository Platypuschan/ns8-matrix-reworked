# Remove the appservice of a bridge module (when the bridge module is
# removed) and restart Synapse.

import json
import os
import subprocess
import sys

import agent

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import matrix_runtime
import matrix_setup

data = json.load(sys.stdin)
caller = os.environ.get("AGENT_TASK_USER", "")
# A module removes only its own registrations; a cluster admin any
owner = caller.removeprefix("module/") if caller.startswith("module/") else None

with matrix_setup.settings_lock():
    try:
        removed = matrix_runtime.remove_appservice(owner, data["id"])
    except matrix_setup.SettingsError as error:
        agent.set_status("validation-failed")
        json.dump([{"field": error.field, "parameter": error.field, "value": error.value,
                    "error": error.error}], fp=sys.stdout)
        sys.exit(2)

if removed and subprocess.run(["systemctl", "--user", "is-active", "--quiet", "synapse.service"]).returncode == 0:
    subprocess.run(["systemctl", "--user", "restart", "synapse.service"], check=True)
    matrix_runtime.wait_for_synapse(matrix_setup.ports()["synapse"])
json.dump({"removed": removed}, fp=sys.stdout)
