# Remove the Traefik routes of the module

import os
import sys

import agent
import agent.tasks

traefik = agent.resolve_agent_id("traefik@node")
if traefik is None:
    print("Default Traefik instance of this node not found", file=sys.stderr)
    sys.exit(2)

for name in ("synapse", "element", "cinny", "ketesa", "wellknown"):
    agent.tasks.run(agent_id=traefik, action="delete-route", data={"instance": os.environ["MODULE_ID"] + "-" + name})
