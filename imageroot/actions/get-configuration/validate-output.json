{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get Matrix settings",
    "$id": "http://nethserver.org/json-schema/task/output/matrix-reworked/get-configuration",
    "description": "Settings, URLs and the admin account of the Matrix module",
    "examples": [
        {
            "server_name": "example.org",
            "host": "matrix.example.org",
            "lets_encrypt": true,
            "http2https": true,
            "user_domain": "ad.example.org",
            "federation": true,
            "wellknown_on_server_name": true,
            "element_host": "chat.example.org",
            "cinny_host": "",
            "ketesa_host": "",
            "mail_from": "",
            "max_upload_mb": 100,
            "configured": true,
            "user_domains": [
                "ad.example.org"
            ],
            "wellknown_server": "{\"m.server\": \"matrix.example.org:443\"}",
            "wellknown_client": "{\"m.homeserver\": {\"base_url\": \"https://matrix.example.org\"}}",
            "admin_user": "@matrixadmin:example.org",
            "admin_password": "secret",
            "homeserver_url": "https://matrix.example.org/",
            "element_url": "https://chat.example.org/",
            "cinny_url": "",
            "ketesa_url": "",
            "turn": true,
            "element_call": true,
            "calls_public_ip": "",
            "calls_ports": [
                "40000/udp",
                "40002-40063/udp",
                "40001/udp",
                "20019/tcp"
            ],
            "draupnir": true,
            "state_compressor": true,
            "shared_secret_auth": false,
            "draupnir_management_room": "!abc:example.org",
            "shared_secret_auth_secret": "",
            "appservices": [
                {
                    "id": "whatsapp",
                    "module": "matrix-whatsapp1"
                }
            ]
        }
    ],
    "type": "object",
    "required": [
        "server_name",
        "host",
        "lets_encrypt",
        "http2https",
        "user_domain",
        "federation",
        "wellknown_on_server_name",
        "element_host",
        "cinny_host",
        "ketesa_host",
        "mail_from",
        "max_upload_mb",
        "configured",
        "user_domains",
        "wellknown_server",
        "wellknown_client",
        "admin_user",
        "admin_password",
        "homeserver_url",
        "element_url",
        "cinny_url",
        "ketesa_url",
        "turn",
        "element_call",
        "calls_public_ip",
        "calls_ports",
        "draupnir",
        "state_compressor",
        "shared_secret_auth",
        "draupnir_management_room",
        "shared_secret_auth_secret",
        "appservices"
    ],
    "properties": {
        "server_name": {
            "type": "string",
            "description": "Matrix server name; empty before the first configuration"
        },
        "host": {
            "type": "string"
        },
        "lets_encrypt": {
            "type": "boolean"
        },
        "http2https": {
            "type": "boolean"
        },
        "user_domain": {
            "type": "string"
        },
        "federation": {
            "type": "boolean"
        },
        "wellknown_on_server_name": {
            "type": "boolean"
        },
        "element_host": {
            "type": "string"
        },
        "cinny_host": {
            "type": "string"
        },
        "ketesa_host": {
            "type": "string"
        },
        "mail_from": {
            "type": "string"
        },
        "max_upload_mb": {
            "type": "integer"
        },
        "configured": {
            "type": "boolean"
        },
        "user_domains": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "User domains of the cluster"
        },
        "wellknown_server": {
            "type": "string",
            "description": "Content of https://<server_name>/.well-known/matrix/server if the server name differs from host"
        },
        "wellknown_client": {
            "type": "string",
            "description": "Content of https://<server_name>/.well-known/matrix/client if the server name differs from host"
        },
        "admin_user": {
            "type": "string",
            "description": "Local Synapse server admin account"
        },
        "admin_password": {
            "type": "string",
            "description": "Initial password of the admin account; empty until the account exists"
        },
        "homeserver_url": {
            "type": "string"
        },
        "element_url": {
            "type": "string"
        },
        "cinny_url": {
            "type": "string"
        },
        "ketesa_url": {
            "type": "string"
        },
        "turn": {
            "type": "boolean"
        },
        "element_call": {
            "type": "boolean"
        },
        "calls_public_ip": {
            "type": "string"
        },
        "calls_ports": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Ports to open/forward for calls, like 40001/udp or 40002-40063/udp"
        },
        "draupnir": {
            "type": "boolean"
        },
        "state_compressor": {
            "type": "boolean"
        },
        "shared_secret_auth": {
            "type": "boolean"
        },
        "draupnir_management_room": {
            "type": "string",
            "description": "Room ID of the Draupnir management room; empty while Draupnir is off or not provisioned"
        },
        "shared_secret_auth_secret": {
            "type": "string",
            "description": "The shared secret of shared-secret-auth; empty while it is off"
        },
        "appservices": {
            "type": "array",
            "description": "Appservices registered by bridge modules",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "module"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "module": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
