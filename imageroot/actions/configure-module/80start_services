set -e
exec 1>&2

# shellcheck disable=SC1091
source ports.env
mapfile -t web_apps < <(python3 -c '
import json
s = json.load(open("matrix.json"))
for app in ("element", "cinny", "ketesa"):
    print(app + ("=on" if s[app + "_host"] else "=off"))
delegated = s["server_name"] != s["host"] and s["wellknown_on_server_name"]
print("wellknown=" + ("on" if delegated else "off"))
print("coturn=" + ("on" if s.get("turn") else "off"))
for unit in ("livekit", "lk-jwt"):
    print(unit + ("=on" if s.get("element_call") else "=off"))
')

# Start a unit, or restart it if a configuration it reads at start changed
start_or_restart() {
    local unit="$1" flag="$2"
    systemctl --user enable "${unit}"
    # A failed earlier start can have hit the start rate limit
    systemctl --user reset-failed "${unit}" || true
    if ! systemctl --user is-active --quiet "${unit}"; then
        systemctl --user start "${unit}"
    elif [[ -e "${flag}" ]]; then
        systemctl --user restart "${unit}"
    fi
    rm -f "${flag}"
}

systemctl --user daemon-reload
start_or_restart postgresql.service restart-needed-postgresql
start_or_restart synapse.service restart-needed-synapse

for item in "${web_apps[@]}"; do
    app="${item%=*}"
    if [[ "${item#*=}" == on ]]; then
        start_or_restart "${app}.service" "restart-needed-${app}"
    else
        systemctl --user disable --now "${app}.service"
        rm -f "restart-needed-${app}"
    fi
done

# Bridges were built in before 0.3.0; they are modules of their own now
while read -r unit _; do
    systemctl --user disable --now "${unit}"
done < <(systemctl --user list-units --all --plain --no-legend 'bridge@*.service')
rm -f restart-needed-bridge-*

# The admin account needs a running Synapse
ensure-admin

# Draupnir needs its account and management room first
if [[ "$(python3 -c 'import json; print(json.load(open("matrix.json")).get("draupnir", False))')" == True ]]; then
    provision-draupnir
    start_or_restart draupnir.service restart-needed-draupnir
else
    systemctl --user disable --now draupnir.service
    rm -f restart-needed-draupnir
fi

if [[ "$(python3 -c 'import json; print(json.load(open("matrix.json")).get("state_compressor", True))')" == True ]]; then
    systemctl --user enable --now synapse-compressor.timer
else
    systemctl --user disable --now synapse-compressor.timer
fi

# Bridge modules read get-matrix-info again (new ports, server settings)
publish-matrix-changed
