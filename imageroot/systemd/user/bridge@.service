#
# LEGACY: bridges were built in before 0.3.0. This unit stays only so that
# configure-module and the update can stop and disable them; bridges are
# modules of their own now (ns8-matrix-bridges).
#
# Bridge %i. state/bridges/%i holds its configuration (mautrix bridges
# complete and update it themselves) and registration; unit.env names the
# image, binary, arguments and network (see bridge_unit_env() in
# matrix_setup.py). The image entrypoints are not used: they would switch to
# an unprivileged UID whose files the module agent cannot read. The bridge
# runs as root of the rootless container, i.e. as the module user. Most
# bridges share the host network namespace to reach Synapse and PostgreSQL
# on 127.0.0.1; an isolated bridge gets its own namespace with the host
# loopback mapped in.
#

[Unit]
Description=Matrix bridge %i
Requires=postgresql.service
Wants=synapse.service
After=postgresql.service synapse.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
EnvironmentFile=%E/state/bridges/%i/unit.env
WorkingDirectory=%E/state
Restart=always
RestartSec=10s
TimeoutStartSec=900
TimeoutStopSec=40
ExecStartPre=/bin/rm -f %t/bridge-%i.pid %t/bridge-%i.ctr-id
ExecStartPre=/bin/sh -c 'podman image exists "${BRIDGE_IMAGE}" || podman pull "${BRIDGE_IMAGE}"'
ExecStartPre=runagent ensure-bridge-database ${BRIDGE_DATABASE}
ExecStart=/usr/bin/podman run --conmon-pidfile %t/bridge-%i.pid \
    --cidfile %t/bridge-%i.ctr-id --cgroups=no-conmon \
    --replace -d --name bridge-%i \
    $BRIDGE_NET \
    --user=0:0 \
    --volume %E/state/bridges/%i:/data:Z \
    --workdir /data \
    --entrypoint ${BRIDGE_BINARY} \
    ${BRIDGE_IMAGE} \
    $BRIDGE_ARGS
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/bridge-%i.ctr-id -t 30
# Bridges that run as PID 1 and ignore SIGTERM (Heisenbridge) are killed
SuccessExitStatus=137 143
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/bridge-%i.ctr-id
SyslogIdentifier=%u
PIDFile=%t/bridge-%i.pid
Type=forking

[Install]
WantedBy=default.target
