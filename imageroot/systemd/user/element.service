#
# Element Web Matrix client (static web app), published on 127.0.0.1 for Traefik.
#

[Unit]
Description=Element Web Matrix client

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
EnvironmentFile=%E/state/ports.env
WorkingDirectory=%E/state
Restart=always
TimeoutStopSec=30
ExecStartPre=/bin/rm -f %t/element.pid %t/element.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/element.pid \
    --cidfile %t/element.ctr-id --cgroups=no-conmon \
    --replace -d --name element \
    --publish 127.0.0.1:${ELEMENT_PORT}:8080 \
    --volume %E/state/web/element.json:/app/config.json:ro,Z \
    --env=ELEMENT_WEB_PORT=8080 \
    ${ELEMENT_WEB_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/element.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/element.ctr-id
SyslogIdentifier=%u
PIDFile=%t/element.pid
Type=forking

[Install]
WantedBy=default.target
