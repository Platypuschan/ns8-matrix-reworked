#!/usr/bin/env python3

# SPDX-License-Identifier: GPL-3.0-or-later

"""Print the published release that the update test starts from.

By default select the newest stable SemVer tag not newer than CATALOG_VERSION.
--strict-older requires a real version upgrade rather than a reinstall.
The module configuration below preserves first-release exit status and any
explicit prerelease fallback; registry/authentication errors remain fatal.
"""

import argparse
import importlib.machinery
import importlib.util
import json
import sys
import urllib.parse
import urllib.request
from pathlib import Path

# BEGIN MODULE CONFIG
# Keep the update-wrapper exit contract; prerelease baselines are opt-in.
NO_RELEASE = 3
FALLBACK_TO_PRERELEASE = False
# END MODULE CONFIG

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]


def load_version_module():
    loader = importlib.machinery.SourceFileLoader(
        "check_catalog_version", str(HERE / "check-catalog-version")
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


version = load_version_module()


def newest_release(tags, current, stable_only=True, strict_older=False):
    """Select a baseline; stable-only and same-version are the safe defaults."""
    limit = version.parse_version(current)
    released = []
    for tag in tags:
        try:
            key = version.parse_version(tag)
        except version.VersionError:
            continue
        # Stable releases only: those are what the catalog offers by default.
        if (key[3] == 1 or not stable_only) and (key < limit if strict_older else key <= limit):
            released.append((key, tag))
    return max(released)[1] if released else None


def registry_tags(image):
    if not image.startswith("ghcr.io/"):
        raise SystemExit(f"Expected a ghcr.io image: {image}")
    name = image.removeprefix("ghcr.io/")
    query = urllib.parse.urlencode({"scope": f"repository:{name}:pull", "service": "ghcr.io"})
    with urllib.request.urlopen(f"https://ghcr.io/token?{query}", timeout=30) as response:
        token = json.load(response)["token"]
    request = urllib.request.Request(
        f"https://ghcr.io/v2/{name}/tags/list?n=1000",
        headers={"Authorization": f"Bearer {token}"},
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.load(response).get("tags") or []


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("image", help="image name without tag, e.g. ghcr.io/owner/module")
    parser.add_argument("--strict-older", action="store_true",
                        help="require a real upgrade baseline, not a same-version reinstall")
    args = parser.parse_args()
    current = (ROOT / "CATALOG_VERSION").read_text(encoding="utf-8").strip()
    tags = registry_tags(args.image)
    tag = newest_release(tags, current, strict_older=args.strict_older)
    if tag is None and FALLBACK_TO_PRERELEASE:
        tag = newest_release(tags, current, stable_only=False, strict_older=args.strict_older)
    if tag is None:
        print(f"No published release of {args.image} up to {current}", file=sys.stderr)
        return NO_RELEASE
    print(f"{args.image}:{tag}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
